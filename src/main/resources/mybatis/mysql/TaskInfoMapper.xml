<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jcloud.system.task.mapper.TaskInfoMapper">
   <select id="findOneById" resultType="com.jcloud.system.task.domain.TaskInfo">
       select * from task_info where id=#{taskInfoId}
   </select>

    <select id="list" resultType="com.jcloud.system.task.domain.TaskInfo">
        select * from task_info
    </select>

    <select id="findByOrgIdAndTaskCodeAndDeletedIsFalse" resultType="com.jcloud.system.task.domain.TaskInfo">
        select * from task_info where sheet_code=#{sheet_code}
    </select>

    <select id="needToHandle" resultType="com.jcloud.system.task.domain.TaskInfo">
        select * from task_info
        where org_id=#{org_id} and processer_id=#{username} and task_status in
        <foreach collection="task_status" index="index" item="task_status" separator="," close=")" open="(">
            #{task_status}
        </foreach>
        order by create_time desc
    </select>

    <select id="findTotal" resultType="java.lang.Integer">
        select count(*) from task_info
        where org_id=#{org_id} and processer_id=#{username} and task_status in
        <foreach collection="task_status" index="index" item="task_status" separator="," close=")" open="(">
            #{task_status}
        </foreach>
    </select>

</mapper>